path = input()
with open(path, "r", encoding='utf-8') as f:
    num = f.read().split()
    for i in num:
        a = int(i)
        k = 2
        count = 0
        while k * k <= a:
            while a % k == 0:
                a = a // k
                count += 1
            k += 1
            if count != 0 and a != 1:
                print(f"{k-1}:{count}", end = " ")
            elif count != 0 and a == 1:
                print(f"{k-1}:{count}")
            count = 0
        if a > 1:
            print(f"{a}:{1}")
